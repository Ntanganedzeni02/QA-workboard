# Optional for local development; REQUIRED for private hosting.
# APP_PASSWORD=choose-a-long-personal-password
# COOKIE_SECURE=true
# APP_URL=https://your-private-dashboard.example.com
# DATABASE_URL=postgresql://user:password@host/database?sslmode=require
# DATA_DIR=/var/lib/paaq
# Vercel Blob adds BLOB_READ_WRITE_TOKEN when the private store is connected.
# Optional Slack OAuth only:
# SLACK_CLIENT_ID=
# SLACK_CLIENT_SECRET=
